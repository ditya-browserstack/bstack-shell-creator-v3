{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "product.config.json",
  "type": "object",
  "required": ["product", "designSystem", "repoPath", "chrome"],
  "additionalProperties": false,
  "properties": {
    "product":       { "type": "string", "minLength": 1 },
    "designSystem":  { "type": "string", "enum": ["designstack", "custom"] },
    "repoPath":      { "type": "string", "minLength": 1 },
    "storybookUrl":  { "type": "string", "format": "uri" },
    "liveUrl":       { "type": "string", "format": "uri" },
    "customSource":  { "type": "string" },
    "chrome": {
      "type": "object",
      "required": ["activeNav"],
      "additionalProperties": false,
      "properties": {
        "topbar":      { "type": "string" },
        "sidebar":     { "type": "string" },
        "activeNav":   { "type": "string", "minLength": 1 },
        "contentSlot": { "type": "string", "description": "CSS class/selector of the shell's empty content region where explorations mount (e.g. .lca-main-slot). Used by the assembler." }
      }
    },
    "vocabulary": { "type": "array", "items": { "type": "string" } },
    "shellSync": {
      "type": "object",
      "description": "Fields shell-sync's onboard needs (maps to its profile). Optional; fill to generate a ready onboard JSON.",
      "additionalProperties": false,
      "properties": {
        "ticketPrefix":       { "type": "string", "description": "Jira project key, e.g. LCNC / LT / LCAM" },
        "repos":              { "type": "array", "items": { "type": "string" }, "description": "Dedicated GitHub repos as owner/name" },
        "sharedRepos":        { "type": "array", "items": { "type": "string" }, "description": "Shared monorepos as owner/name" },
        "productSignals":     { "type": "array", "items": { "type": "string" }, "description": "Words marking this product's work in shared repos" },
        "dropBranchPatterns": { "type": "array", "items": { "type": "string" }, "description": "Production branches, e.g. main / master" }
      }
    }
  }
}
